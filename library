-- Layout Synchronizer: Coordinates NavSidebar, Top Search Bar, and Content ScrollingFrame
local syncAllWindowLayout
do
    local windowSearchBar = nil
    local isSyncingLayout = false

    local function lockPageGeometry(page, contentPos, contentSize)
        if not page then return end
        page.AnchorPoint = Vector2.new(0, 0)
        page.Position = contentPos
        page.Size = contentSize
        page.ClipsDescendants = true
        page.ZIndex = 20
    end

    local lockedPages = {}

    local function trackPageLock(page)
        if not page or lockedPages[page] then return end
        lockedPages[page] = true
        
        local function enforce()
            if isSyncingLayout then return end
            syncAllWindowLayout()
        end
        
        page:GetPropertyChangedSignal("AnchorPoint"):Connect(enforce)
        page:GetPropertyChangedSignal("Position"):Connect(enforce)
        page:GetPropertyChangedSignal("Size"):Connect(enforce)
    end

    local searchTrackingConnected = false
    local function trackSearchLock(bar)
        if searchTrackingConnected or not bar then return end
        searchTrackingConnected = true
        
        local function enforce()
            if isSyncingLayout then return end
            syncAllWindowLayout()
        end
        
        bar:GetPropertyChangedSignal("Position"):Connect(enforce)
        bar:GetPropertyChangedSignal("Size"):Connect(enforce)
        bar:GetPropertyChangedSignal("AnchorPoint"):Connect(enforce)
    end

    function syncAllWindowLayout()
        if isSyncingLayout then return end
        isSyncingLayout = true

        local topH = (topBar and topBar.AbsoluteSize.Y > 0) and topBar.AbsoluteSize.Y or 48
        local sidebarW = 144
        local margin = 8
        
        -- 1. Single NavSidebar on the left inside mainFrame
        if navSidebar then
            navSidebar.Position = UDim2.new(0, margin, 0, topH + margin)
            navSidebar.Size = UDim2.new(0, sidebarW, 1, -(topH + margin * 2))
            navSidebar.ZIndex = 30
        end

        local contentX = margin + sidebarW + 10 -- 162px offset
        local contentW = -(contentX + margin)   -- -170px width offset
        local searchH = 30
        
        -- 2. Dedicated Native Ocean Search Bar at the TOP
        if windowSearchBar then
            windowSearchBar.Position = UDim2.new(0, contentX, 0, topH + margin)
            windowSearchBar.Size = UDim2.new(1, contentW, 0, searchH)
            windowSearchBar.Visible = true
        end
        
        -- Completely eliminate unwanted "Quick Access" sections and ghost headers from all normal tabs
        for _, desc in ipairs(mainFrame:GetDescendants()) do
            local dName = desc.Name:lower()
            if dName == "quick accesssection" or (desc:IsA("Frame") and dName:find("quick access")) then
                local isQuickTab = false
                if ChilliLibrary and ChilliLibrary.Window and ChilliLibrary.Window.Tabs then
                    for _, tab in ipairs(ChilliLibrary.Window.Tabs) do
                        if tab.Name == "Quick & Keys" and desc:IsDescendantOf(tab.Page) then
                            isQuickTab = true
                            break
                        end
                    end
                end
                if not isQuickTab then
                    desc.Visible = false
                    desc.Size = UDim2.new(0, 0, 0, 0)
                    desc.Position = UDim2.new(0, 0, 0, -99999)
                end
            elseif desc:IsA("TextLabel") and desc.Text:lower():find("quick access") then
                local isQuickTab = false
                if ChilliLibrary and ChilliLibrary.Window and ChilliLibrary.Window.Tabs then
                    for _, tab in ipairs(ChilliLibrary.Window.Tabs) do
                        if tab.Name == "Quick & Keys" and desc:IsDescendantOf(tab.Page) then
                            isQuickTab = true
                            break
                        end
                    end
                end
                if not isQuickTab then
                    desc.Visible = false
                end
            end
        end
        
        -- 3. Content list & Tab Pages below Search Bar with 8px clean gap
        local searchOffset = searchH + 8
        local contentTop = topH + margin + searchOffset
        local contentPos = UDim2.new(0, contentX, 0, contentTop)
        local contentSize = UDim2.new(1, contentW, 1, -(contentTop + margin))
        
        if objects.obj25 then
            lockPageGeometry(objects.obj25, contentPos, contentSize)
            trackPageLock(objects.obj25)
        end
        
        if ChilliLibrary and ChilliLibrary.Window and ChilliLibrary.Window.Tabs then
            for _, tab in ipairs(ChilliLibrary.Window.Tabs) do
                if tab.Page then
                    lockPageGeometry(tab.Page, contentPos, contentSize)
                    trackPageLock(tab.Page)
                end
            end
        end
        
        isSyncingLayout = false
    end

    -- Dedicated Native Ocean Search Bar (Zero errors, live filtering across tabs)
    windowSearchBar = Instance.new("Frame")
    windowSearchBar.Name = "WindowSearchBar"
    windowSearchBar.BackgroundColor3 = Color3.fromRGB(18, 62, 115)
    windowSearchBar.BackgroundTransparency = 0.58
    windowSearchBar.BorderSizePixel = 0
    windowSearchBar.ZIndex = 25
    windowSearchBar.Parent = mainFrame

    local sCorner = Instance.new("UICorner")
    sCorner.CornerRadius = UDim.new(0, 6)
    sCorner.Parent = windowSearchBar

    local sStroke = Instance.new("UIStroke")
    sStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
