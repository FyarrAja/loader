            end
            local zoom = canvasNumber(spec.Zoom, 1.05)
            if zoom ~= state.Zoom and state.Radius then
                state.Distance = state.Radius / math.tan(math.rad(camera.FieldOfView / 2)) * zoom
            end
            state.Zoom = zoom
            state.Height = canvasNumber(spec.CameraHeight, 0.35)
