        pcall(function()
            topLeftInset, bottomRightInset = GuiService:GetGuiInset()
        end)

        local screenW = math.max(viewport.X - topLeftInset.X - bottomRightInset.X, 1)
        local screenH = math.max(viewport.Y - topLeftInset.Y - bottomRightInset.Y, 1)

        local marginX = 24
        local marginY = 20

        local baseW = 580
        local baseH = 430

        local availW = screenW - (marginX * 2)
        local availH = screenH - (marginY * 2)

        local scaleX = availW / baseW
        local scaleY = availH / baseH

        local requiredScale = math.min(scaleX, scaleY)
        local finalScale = math.clamp(requiredScale, 0.38, 1.0)
        return finalScale, baseW, baseH
    end

    local autoScale, baseW, baseH = calculateWindowAutoScale()
    Runtime.autoScale = autoScale
    Runtime.calculateWindowAutoScale = calculateWindowAutoScale

