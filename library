local purgeBottomSearchBar
do
    local function inspectAndPurgeSearchNode(desc)
        if not desc or not desc.Parent then return end
        local isBottomSearch = false
        if desc:IsA("TextBox") then
            if not (Runtime.SearchBar and desc:IsDescendantOf(Runtime.SearchBar)) then
                local pText = tostring(desc.PlaceholderText or ""):lower()
                if pText:find("filter") or (pText:find("feature") and not pText:find("cari")) then
                    isBottomSearch = true
                end
            end
        elseif (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Text == "Search" then
            if not (Runtime.SearchBar and desc:IsDescendantOf(Runtime.SearchBar)) then
                local p = desc.Parent
                if p and p:FindFirstChildWhichIsA("TextBox") then
                    isBottomSearch = true
                end
            end
        end

        if isBottomSearch then
            local target = desc
            local cur = desc
            while cur and cur.Parent and cur.Parent ~= rootGui and cur.Parent ~= mainFrame do
                cur = cur.Parent
            end
            if cur and cur.Parent and cur ~= objects.obj4 and cur ~= objects.obj25 and cur ~= objects.obj70 and cur ~= Runtime.SearchBar and cur ~= launcherGui then
                target = cur
            end
            pcall(function()
                target.Visible = false
                target:Destroy()
            end)
        end
    end

    purgeBottomSearchBar = function()
        pcall(function()
            if mainFrame then
                for _, desc in ipairs(mainFrame:GetDescendants()) do
                    inspectAndPurgeSearchNode(desc)
                end
            end
            if rootGui then
                for _, child in ipairs(rootGui:GetChildren()) do
                    if child ~= mainFrame and child ~= launcherGui then
                        inspectAndPurgeSearchNode(child)
                        for _, desc in ipairs(child:GetDescendants()) do
                            inspectAndPurgeSearchNode(desc)
                        end
                    end
                end
            end
        end)
    end

    local function onDescendantAdded(desc)
        if not desc then return end
        if desc:IsA("TextBox") or desc:IsA("TextLabel") or desc:IsA("TextButton") then
            task.defer(inspectAndPurgeSearchNode, desc)
        end
    end

    mainFrame.DescendantAdded:Connect(onDescendantAdded)
end

