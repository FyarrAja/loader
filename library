            for _, root in ipairs(containers) do
                if root then
                    for _, desc in ipairs(root:GetDescendants()) do
                        if desc and desc.Parent then
                            local isBottomSearch = false
                            if desc:IsA("TextBox") then
                                if not (windowSearchBar and desc:IsDescendantOf(windowSearchBar)) then
                                    local pText = tostring(desc.PlaceholderText or ""):lower()
                                    if pText:find("filter") or (pText:find("feature") and not pText:find("cari")) then
                                        isBottomSearch = true
                                    end
                                end
                            elseif (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Text == "Search" then
                                if not (windowSearchBar and desc:IsDescendantOf(windowSearchBar)) then
                                    local p = desc.Parent
                                    if p and p:FindFirstChildWhichIsA("TextBox") then
                                        isBottomSearch = true
                                    end
                                end
                            end

                            if isBottomSearch then
                                local target = desc
                                local cur = desc
                                while cur and cur.Parent and cur.Parent ~= rootGui and cur.Parent ~= mainFrame and cur.Parent ~= parent do
                                    cur = cur.Parent
                                end
                                if cur and cur.Parent and cur ~= objects.obj4 and cur ~= objects.obj25 and cur ~= objects.obj70 and cur ~= windowSearchBar and cur ~= launcherGui then
                                    target = cur
                                end
                                pcall(function()
                                    target.Visible = false
                                    target:Destroy()
                                end)
                            end
                        end
                    end
                end
            end
        end)
    end

    local function onDescendantAdded(desc)
        if not desc then return end
        if desc:IsA("TextBox") or desc:IsA("TextLabel") or desc:IsA("TextButton") then
            local pText = (desc:IsA("TextBox") and tostring(desc.PlaceholderText or ""):lower()) or ""
            local tText = (not desc:IsA("TextBox") and tostring(desc.Text or "")) or ""
            if pText:find("filter") or pText:find("feature") or tText == "Search" then
                task.defer(purgeBottomSearchBar)
            end
        end
    end

    rootGui.DescendantAdded:Connect(onDescendantAdded)
    mainFrame.DescendantAdded:Connect(onDescendantAdded)
    if parent and parent ~= rootGui then
        pcall(function() parent.DescendantAdded:Connect(onDescendantAdded) end)
    end

    task.spawn(function()
        for _ = 1, 20 do
            purgeBottomSearchBar()
            task.wait(0.25)
        end
    end)

end

