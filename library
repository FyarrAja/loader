    sClear.Text = "✕"
    sClear.TextSize = 13
    sClear.TextColor3 = Color3.fromRGB(140, 185, 225)
    sClear.Visible = false
    sClear.ZIndex = 27
    sClear.Parent = windowSearchBar

    sClear.MouseButton1Click:Connect(function()
        sBox.Text = ""
    end)

    local function applyLiveSearch(query)
        query = tostring(query or ""):lower():match("^%s*(.-)%s*$") or ""
        sClear.Visible = (query ~= "")
        
        local activeTab = ChilliLibrary and ChilliLibrary.Window and ChilliLibrary.Window.SelectedTab
        if not activeTab then return end
        
        if type(activeTab._applySearch) == "function" then
            pcall(function() activeTab._applySearch(query) end)
        end
        
        if activeTab.Sections then
            for _, section in ipairs(activeTab.Sections) do
                local sectionHasMatch = false
                if section.Options then
                    for _, option in ipairs(section.Options) do
                        local optName = tostring(option.DisplayName or option.Name or ""):lower()
                        local matched = (query == "") or optName:find(query, 1, true) ~= nil
                        if option._visibilityHost then
                            option._visibilityHost.Visible = matched
                        elseif option.Instance then
                            option.Instance.Visible = matched
                        end
                        if matched then
                            sectionHasMatch = true
                        end
                    end
                end
                if section._container and section.Name and not section.Name:lower():find("quick access") then
                    section._container.Visible = (query == "") or sectionHasMatch
                end
            end
        end
        if type(activeTab._updateCanvas) == "function" then
            pcall(activeTab._updateCanvas)
        end
    end

    sBox:GetPropertyChangedSignal("Text"):Connect(function()
        applyLiveSearch(sBox.Text)
    end)

    mainFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncAllWindowLayout)

    ContentScale.OnChanged(function(scaleX, scaleY)
        syncAllWindowLayout()
    end)
end

