    elseif state == "hover" then
        if objects.obj3 then
            TweenService:Create(objects.obj3, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Color = Color3.fromRGB(0, 200, 255),
                Thickness = 1.8,
