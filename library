    local function getOptionSearchBlob(option)
        if option._cachedSearchBlob then
            return option._cachedSearchBlob
        end
        local parts = {
            tostring(option.DisplayName or ""):lower(),
            tostring(option.Name or ""):lower(),
        }
        local sc = option._sourceConfig
        if sc then
            local checkFields = {"Title", "Text", "ButtonText", "ClickedText", "Description", "Note", "Placeholder"}
            for _, k in ipairs(checkFields) do
                local val = sc[k]
                if val ~= nil then
                    parts[#parts + 1] = tostring(val):lower()
                end
            end
        end
        if option.Instance then
            for _, desc in ipairs(option.Instance:GetDescendants()) do
                if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                    local dt = tostring(desc.Text or ""):lower()
                    if dt ~= "" then
                        parts[#parts + 1] = dt
                    end
                end
            end
        end
        option._cachedSearchBlob = table.concat(parts, "\n")
        return option._cachedSearchBlob
    end

    local function applyLiveSearch(query)
        query = tostring(query or ""):lower():match("^%s*(.-)%s*$") or ""
        Runtime.currentSearchQuery = query
        sClear.Visible = (query ~= "")

        local win = Runtime.Window or (ChilliLibrary and ChilliLibrary.Window)
        local activeTab = win and (win.SelectedTab or win.DefaultTab or (win.Tabs and win.Tabs[1]))
        if not activeTab then return end

        local tabHasAnyMatch = false

        if activeTab.Sections then
            for _, section in ipairs(activeTab.Sections) do
                local isQuickSection = section.Name and section.Name:lower():find("quick access") ~= nil
                if not isQuickSection then
                    if query == "" then
                        if section._searchSavedExpanded ~= nil then
                            section.Expanded = section._searchSavedExpanded
                            section._searchSavedExpanded = nil
                        end
                        if section._container then
                            section._container.Visible = true
                        end
                        if section._arrow then
                            section._arrow.Rotation = section.Expanded and 0 or -90
                        end
                        if section._group then
                            section._group.Visible = section.Expanded
                            section._group.ClipsDescendants = not section.Expanded
                        end
                        if section.Options then
                            for _, option in ipairs(section.Options) do
                                local vis = (option._resolvedVisible ~= false) and (option._manualVisible ~= false)
                                if option._visibilityHost then
                                    option._visibilityHost.Visible = vis
                                end
                                if option.Instance then
                                    option.Instance.Visible = vis
                                end
                            end
                        end
                        if section._refreshLayout then
                            pcall(section._refreshLayout)
                        elseif section._refreshHeight then
                            pcall(section._refreshHeight)
                        end
                    else
                        local secDisplayName = tostring(section.DisplayName or section.Name or ""):lower()
                        local sectionNameMatches = (secDisplayName:find(query, 1, true) ~= nil)
                        local sectionMatchCount = 0

                        if section.Options then
                            for _, option in ipairs(section.Options) do
                                local baseVis = (option._resolvedVisible ~= false) and (option._manualVisible ~= false)
                                local optMatched = false
                                if baseVis then
                                    optMatched = sectionNameMatches or (getOptionSearchBlob(option):find(query, 1, true) ~= nil)
                                end

                                if option._visibilityHost then
                                    option._visibilityHost.Visible = optMatched
                                end
                                if option.Instance then
                                    option.Instance.Visible = optMatched
                                end
                                if optMatched then
                                    sectionMatchCount = sectionMatchCount + 1
                                end
                            end
                        end

                        if sectionMatchCount > 0 then
                            tabHasAnyMatch = true
                            if section._searchSavedExpanded == nil then
                                section._searchSavedExpanded = section.Expanded
                            end
                            section.Expanded = true
                            if section._arrow then
                                section._arrow.Rotation = 0
                            end
                            if section._container then
                                section._container.Visible = true
                            end
                            if section._group then
                                section._group.Visible = true
                                section._group.ClipsDescendants = false
                            end
                            if section._refreshLayout then
                                pcall(section._refreshLayout)
                            elseif section._refreshHeight then
                                pcall(section._refreshHeight)
                            end
                        else
                            if section._container then
                                section._container.Visible = false
                            end
                        end
                    end
                end
            end
        end

        if activeTab.Page then
            local emptyNotice = activeTab.Page:FindFirstChild("BH_SearchEmptyNotice")
