    sGrad.Rotation = 90
    sGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 140, 230)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 50, 95)),
    })
    sGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.40),
        NumberSequenceKeypoint.new(1, 0.65),
    })
    sGrad.Parent = windowSearchBar

