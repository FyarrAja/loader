-- WindUI-style resize: operates directly in unscaled UDim2.fromOffset coordinates with smooth Quad Out tween
local function applyWindUIResize(unscaledWidth, unscaledHeight)
    local clampedW = math.clamp(math.floor(unscaledWidth + 0.5), WINDUI_MIN_SIZE.X, WINDUI_MAX_SIZE.X)
    local clampedH = math.clamp(math.floor(unscaledHeight + 0.5), WINDUI_MIN_SIZE.Y, WINDUI_MAX_SIZE.Y)
    Runtime.menuSize = UDim2.fromOffset(clampedW, clampedH)
    rootGui:SetAttribute("MenuSize", Runtime.menuSize)

    if activeResizeTween then
        activeResizeTween:Cancel()
    end
    activeResizeTween = TweenService:Create(mainFrame, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Runtime.menuSize,
    })
    activeResizeTween:Play()

    ContentScale.Refresh()
    if type(syncAllWindowLayout) == "function" then
        syncAllWindowLayout()
    end
end

local function applyResizeSize(widthPixels, heightPixels)
    if resizeDragging then
        return
    end
    local currentScale = Runtime.autoScale or 1.0
    if currentScale <= 0 then currentScale = 1.0 end
    applyWindUIResize(widthPixels / currentScale, heightPixels / currentScale)
end

local function resizeFromInputPosition(position)
    local currentScale = Runtime.autoScale or 1.0
    if currentScale <= 0 then currentScale = 1.0 end
    local delta = (Vector2.new(position.X, position.Y) - resizeStartPointer) / currentScale
    applyWindUIResize(
        resizeStartSize.X + delta.X * 2,
        resizeStartSize.Y + delta.Y * 2
    )
end

