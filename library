local function applyResizeSize(widthPixels, heightPixels, isFinal)
    local region = rootGui.AbsoluteSize
    if region.X <= 0 or region.Y <= 0 then
        return
    end
    -- Strict Min/Max clamping: Min 380x270, Max 720x520 (or 92% screen)
    local maxAllowedW = math.min(720, region.X * 0.92)
    local maxAllowedH = math.min(520, region.Y * 0.90)
    local clampedW = math.clamp(widthPixels, 380, math.max(380, maxAllowedW))
    local clampedH = math.clamp(heightPixels, 270, math.max(270, maxAllowedH))
    Runtime.menuSize = UDim2.fromScale(
        clampedW / region.X,
        clampedH / region.Y
    )
    rootGui:SetAttribute("MenuSize", Runtime.menuSize)
    
    if activeResizeTween then
        activeResizeTween:Cancel()
    end
    
    if isFinal then
        -- Satisfying settle on mouse release
        activeResizeTween = TweenService:Create(mainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = Runtime.menuSize
        })
        activeResizeTween:Play()
    else
        -- Immediate 1:1 response during active drag with zero lag
        mainFrame.Size = Runtime.menuSize
    end
    ContentScale.Refresh()
    syncAllWindowLayout()
end

local function resizeFromInputPosition(position, isFinal)
    local delta = Vector2.new(position.X, position.Y) - resizeStartPointer
    applyResizeSize(
        resizeStartSize.X + delta.X * 2,
        resizeStartSize.Y + delta.Y * 2,
        isFinal
    )
end

