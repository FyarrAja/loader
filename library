        if mainFrame and not mainFrame.Visible then return end
        pcall(function()
            local sound = Instance.new("Sound")
            sound.Name = "ToggleTactileClick"
            sound.SoundId = "rbxassetid://102702078778790"
            sound.Volume = 0.28
            sound.Parent = SoundService or rootGui
            sound:Play()
            Debris:AddItem(sound, 1.2)
        end)
