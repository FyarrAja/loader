        local targetPos = enabled and UDim2.fromScale(0.74, 0.5) or UDim2.fromScale(0.26, 0.5)
        local targetFillTrans = enabled and 0 or 1
        local targetStrokeColor = enabled and Color3.fromRGB(60, 225, 255) or Color3.fromRGB(28, 52, 84)
        local targetStrokeTrans = enabled and 0.1 or 0.35
        local targetThumbColor = enabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(195, 215, 238)
        local targetThumbStroke = enabled and Color3.fromRGB(0, 180, 250) or Color3.fromRGB(35, 60, 90)

