local function setTabSelected(tab, selected)
    local isSelected = selected == true
    tab.Page.Visible = isSelected
    if tab.Button then
        tab.Button:SetAttribute("TabSelected", isSelected)
    end
    local isHovered = tab.Button and (tab.Button:GetAttribute("TabHovered") == true) or false
    local base = tab.Button and tab.Button:FindFirstChild("Main")
    if base then
        base.Size = UDim2.fromScale(1, 1)
        base.BackgroundColor3 = isSelected
            and (isHovered and Color3.fromRGB(0, 175, 255) or Color3.fromRGB(0, 140, 255))
            or (isHovered and Color3.fromRGB(0, 115, 245) or Color3.fromRGB(8, 34, 72))
        local colorFrame = base:FindFirstChild("ColorFrame")
        if colorFrame then
            colorFrame.BackgroundColor3 = isSelected and Color3.fromRGB(255, 255, 255)
                or (isHovered and Color3.fromRGB(235, 248, 255) or Color3.fromRGB(175, 205, 235))
            local highlight = colorFrame:FindFirstChild("Transparent")
            if highlight then
                highlight.BackgroundColor3 = isSelected and Color3.fromRGB(255, 255, 255)
                    or (isHovered and Color3.fromRGB(235, 248, 255) or Color3.fromRGB(165, 198, 230))
            end
            local grad = colorFrame:FindFirstChild("RedGradient")
            if grad then
                grad.Color = isSelected and ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(220, 245, 255)),
                    ColorSequenceKeypoint.new(0.06, Color3.fromRGB(0, 195, 255)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 130, 240)),
                }) or ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 160, 200)),
                    ColorSequenceKeypoint.new(0.06, Color3.fromRGB(20, 50, 90)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 30, 60)),
                })
            end
        end
        local stroke = base:FindFirstChildWhichIsA("UIStroke")
        if stroke then
            stroke.Color = isSelected
                and (isHovered and Color3.fromRGB(130, 245, 255) or Color3.fromRGB(0, 225, 255))
                or (isHovered and Color3.fromRGB(70, 210, 255) or Color3.fromRGB(10, 40, 80))
            stroke.Transparency = isSelected and 0 or (isHovered and 0.05 or 0.3)
        end
    end
end

