        text.TextTruncate = Enum.TextTruncate.AtEnd
        text.TextXAlignment = Enum.TextXAlignment.Left
        text.TextYAlignment = Enum.TextYAlignment.Center
        text.FontFace = normalTextFont
        text.TextColor3 = Color3.fromRGB(225, 242, 255)
        text.TextSize = 13
        text.TextStrokeColor3 = Color3.fromRGB(0, 15, 40)
        text.TextStrokeTransparency = 0.5
        text.ZIndex = 18
        text.Parent = item

        local hovered = false

        local function isChosen()
            if multiSelect then
                return selected[index] == true
            end
            return currentIndex == index
        end

        local function paint(animated)
            local chosen = isChosen()
            local bgAlpha = chosen and 0.30 or (hovered and 0.72 or 1)
            local bgColor = chosen and Color3.fromRGB(0, 135, 245) or (hovered and Color3.fromRGB(0, 160, 255) or Color3.fromRGB(255, 255, 255))
            local strokeAlpha = chosen and 0.20 or (hovered and 0.55 or 1)
            local strokeColor = chosen and Color3.fromRGB(80, 235, 255) or Color3.fromRGB(0, 200, 255)

            if multiSelect then
                tickBox.BackgroundColor3 = chosen and Color3.fromRGB(0, 175, 255) or Color3.fromRGB(15, 48, 92)
                tickBox.BackgroundTransparency = chosen and 0 or 0.4
                if tbStroke then
                    tbStroke.Color = chosen and Color3.fromRGB(0, 245, 255) or Color3.fromRGB(0, 200, 255)
                    tbStroke.Transparency = chosen and 0 or 0.35
                end
                tickCheck.Visible = chosen
            else
                accentBar.Visible = chosen
                accentBar.Size = UDim2.new(0, chosen and 3 or 0, 1, 0)
                singleCheck.Visible = chosen
            end

            text.TextColor3 = chosen and Color3.fromRGB(255, 255, 255) or (hovered and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(225, 242, 255))

            if animated then
                local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                TweenService:Create(item, info, {
                    BackgroundColor3 = bgColor,
                    BackgroundTransparency = bgAlpha,
                }):Play()
                TweenService:Create(itemStroke, info, {
                    Color = strokeColor,
                    Transparency = strokeAlpha,
                }):Play()
            else
                item.BackgroundColor3 = bgColor
                item.BackgroundTransparency = bgAlpha
                itemStroke.Color = strokeColor
                itemStroke.Transparency = strokeAlpha
            end
        end

        item.MouseEnter:Connect(function()
            hovered = true
            paint(true)
        end)
        item.MouseLeave:Connect(function()
            hovered = false
            paint(true)
        end)

        connectSafeActivation(item, function()
            if multiSelect then
                if selected[index] then
                    selected[index] = nil
                else
                    selected[index] = true
                end
                refreshSelection(true)
            else
                currentIndex = index
                refreshSelection(true)
                if not action then
                    setOpen(false)
                end
            end
        end)

        items[index] = { button = item, paint = paint }
    end

    refreshSelection = function(animated)
        for _, entry in ipairs(items) do
            entry.paint(animated)
        end
        value.Text = describeSelection()
        if applyButton then
            local picked = 0
            if multiSelect then
                for idx = 1, #options do
                    if selected[idx] then
                        picked = picked + 1
                    end
                end
            elseif options[currentIndex] then
                picked = 1
            end

            applyCaption.Text = (multiSelect and picked > 0)
                    and (applyBaseText .. " (" .. picked .. ")")
                or applyBaseText
            applyReady = picked > 0
            applyCaption.TextTransparency = applyReady and 0 or 0.45
            applyButton.AutoButtonColor = applyReady
        end
    end

    if action and applyButton then
        connectSafeActivation(applyButton, function()
            if multiSelect and not applyReady then
                return
            end
            local values, indices = getControllerValue()
            setOpen(false)
            if type(action.OnApply) == "function" then
                action.OnApply(values, indices)
            end
        end)
    end

    local function applyFilter()
        local query = searchQuery:lower()
        visibleItems = {}
        for index, entry in ipairs(items) do
            local matched = query == ""
                or options[index]:lower():find(query, 1, true) ~= nil
            entry.button.Visible = matched
            if matched then
                table.insert(visibleItems, entry)
            end
        end
        emptyLabel.Visible = #visibleItems == 0
    end

    local heightTween, menuTween
    local headHeight = 0
    local menuHeight = 0
    local gapSize = 4

    local function applyOpenState(animated)
        if heightTween then
            heightTween:Cancel()
            heightTween = nil
        end
        if menuTween then
            menuTween:Cancel()
            menuTween = nil
        end

        local totalRowH = headHeight + (isOpen and (gapSize + menuHeight) or 0)
        local rowTarget = UDim2.new(row.Size.X.Scale, row.Size.X.Offset, 0, totalRowH)
        local menuTarget = UDim2.new(1, 0, 0, isOpen and menuHeight or 0)

        if isOpen then
            menuClip.Visible = true
        end

        if animated then
            local info = TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            heightTween = TweenService:Create(row, info, { Size = rowTarget })
            menuTween = TweenService:Create(menuClip, info, { Size = menuTarget })
            if not isOpen then
                menuTween.Completed:Connect(function(state)
                    if state == Enum.PlaybackState.Completed and not isOpen then
                        menuClip.Visible = false
                    end
                end)
            end
            heightTween:Play()
            menuTween:Play()
        else
            row.Size = rowTarget
            menuClip.Size = menuTarget
            menuClip.Visible = isOpen
        end
    end

    refreshGeometry = function(animated)
        local width = row.AbsoluteSize.X
        if width <= 0 then
            return
        end

        local referenceWidth = width
        if not RESIZE_KEEPS_OPTION_WIDTH then
            referenceWidth = width / ContentScale.X
        end
        local band = referenceWidth / ROW_ASPECT
        headHeight = currentNote ~= "" and referenceWidth / ROW_ASPECT_WITH_NOTE or band
        head.Size = UDim2.new(1, 0, 0, headHeight)
        menuClip.Position = UDim2.new(0.5, 0, 0, headHeight + gapSize)

        if not isOpen and not animated then
            applyOpenState(false)
            return
        end

        local topOffset = 6
        if hintLabel then
            hintLabel.Position = UDim2.new(0.5, 0, 0, topOffset)
            topOffset = topOffset + 18
        end
        if searchField then
            searchField.Position = UDim2.new(0.5, 0, 0, topOffset)
            topOffset = topOffset + 30
        end

        local visCount = #visibleItems
        local maxVisibleItems = 5
        local displayedCount = math.clamp(visCount, 1, maxVisibleItems)
        local itemH = 28
        local itemPad = 4
        local listH = displayedCount * itemH + math.max(0, displayedCount - 1) * itemPad
        if visCount == 0 then
            listH = itemH
        end

        scrollFrame.Position = UDim2.new(0, 6, 0, topOffset)
        scrollFrame.Size = UDim2.new(1, -12, 0, listH)
        local totalCanvasH = visCount * itemH + math.max(0, visCount - 1) * itemPad
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, totalCanvasH)

        topOffset = topOffset + listH + 6

        if applyButton then
            applyButton.Position = UDim2.new(0.5, 0, 0, topOffset)
            topOffset = topOffset + 34
        end

        menuHeight = topOffset

        refreshSelection(false)
        applyOpenState(animated)
    end

    setOpen = function(open)
        if isOpen == open then
            return
        end
        if open then
            closeActiveDropdown()
            if searchBox then
                searchBox.Text = ""
            end
            searchQuery = ""
            applyFilter()
        elseif searchBox then
            searchBox:ReleaseFocus()
        end
        isOpen = open
        Runtime.activeDropdownCloser = open and function()
            setOpen(false)
        end or nil

        TweenService:Create(
            caret,
            TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Rotation = open and 180 or 0 }
        ):Play()
        TweenService:Create(box, TweenInfo.new(0.16), {
            BackgroundTransparency = open and 0.20 or 0.35,
        }):Play()
        local bStroke = box:FindFirstChild("BoxStroke")
        if bStroke then
            TweenService:Create(bStroke, TweenInfo.new(0.16), {
                Transparency = open and 0 or 0.25,
                Color = open and Color3.fromRGB(120, 240, 255) or Color3.fromRGB(80, 215, 255),
            }):Play()
        end

        refreshGeometry(true)
    end

    if searchBox then
        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            searchQuery = searchBox.Text:match("^%s*(.-)%s*$") or ""
            applyFilter()
            refreshGeometry(true)
        end)
    end

    connectSafeActivation(box, function()
        setOpen(not isOpen)
    end)

    local lastWidth = 0
    row:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        local width = row.AbsoluteSize.X
        if math.abs(width - lastWidth) < 0.5 then
            return
        end
        lastWidth = width
        refreshGeometry(false)
    end)

    task.defer(function()
        RunService.RenderStepped:Wait()
        lastWidth = row.AbsoluteSize.X
        applyFilter()
        refreshSelection(false)
        refreshGeometry(false)
    end)

    local function resolveControllerIndex(choice)
        if type(choice) == "number" then
            return math.clamp(math.floor(choice), 1, #options)
        end
        for index, option in ipairs(options) do
            if option == tostring(choice) then
                return index
            end
        end
        return nil
    end

    local function setControllerValue(newValue)
        if multiSelect then
            selected = {}
            local choices = type(newValue) == "table" and newValue or { newValue }
            for _, choice in ipairs(choices) do
                local index = resolveControllerIndex(choice)
                if index then
                    selected[index] = true
                end
            end
        else
            local index = resolveControllerIndex(newValue)
            if index then
                currentIndex = index
            end
        end
        refreshSelection(false)
    end

    return row, {
        GetValue = getControllerValue,
        SetValue = setControllerValue,
        Apply = function()
            local values, indices = getControllerValue()
            setOpen(false)
            if action and type(action.OnApply) == "function" then
                action.OnApply(values, indices)
            end
        end,
        SetHint = function(text)
            if hintLabel then
                hintLabel.Text = tostring(text or "")
            end
        end,
        SetActionText = function(text)
            if applyButton then
                applyBaseText = tostring(text or applyBaseText)
                refreshSelection(false)
            end
        end,
        GetNote = function()
            return currentNote
        end,
        SetNote = function(value)
            currentNote = tostring(value or "")
            applyNoteLayout()
            refreshGeometry(false)
        end,
    }
end

-- Square box button (no UICorner, exactly like sidebar rebirth buttons)
local function createButtonRow(name, labelText, buttonText, confirmText)
    local row, main = buildFixedRow(name, labelText)
    local currentButtonText = tostring(buttonText or "Click")
    local currentConfirmText = (type(confirmText) == "string" and confirmText ~= "" and confirmText)
        or (confirmText == true and "Clicked!")
        or nil
    local busy = false

    local button = Instance.new("TextButton")
    button.Name = "Action"
    button.Active = true
    button.AutoButtonColor = false
    button.AnchorPoint = Vector2.new(0.5, 0.5)
    button.BackgroundTransparency = 1
    button.BorderSizePixel = 0
    button.Position = UDim2.fromScale(CONTROL_LAYOUT.NarrowCenterX, 0.5)
    button.Size = UDim2.fromScale(CONTROL_LAYOUT.NarrowWidth, 0.68)
    button.Text = ""
    button.ZIndex = 6
    button:SetAttribute("FW_Bypassed", true)
    button.Parent = main

    local base = Instance.new("Frame")
    base.Name = "Main"
    base.Active = false
    base.AnchorPoint = Vector2.new(0.5, 0.5)
    base.BackgroundColor3 = Color3.fromRGB(0, 70, 180)
    base.BorderSizePixel = 0
    base.Position = UDim2.fromScale(0.5, 0.5)
    base.Size = UDim2.fromScale(1, 0.92)
    base.ZIndex = 1
    base.Parent = button

    -- Tactile scale controller for satisfying click depression & bounce
    local btnScale = Instance.new("UIScale")
    btnScale.Name = "ButtonScale"
    btnScale.Scale = 1
    btnScale.Parent = base

    -- Sharp square edges (No UICorner per user instruction: "button tuh kotak ga ada yg rounded")
    local baseStroke = Instance.new("UIStroke")
    baseStroke.Name = "ButtonStroke"
    baseStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    baseStroke.Color = Color3.fromRGB(0, 220, 255)
    baseStroke.Thickness = 1.2
    baseStroke.Transparency = 0
    baseStroke.Parent = base

    local colorFrame = Instance.new("Frame")
    colorFrame.Name = "ColorFrame"
    colorFrame.Active = false
    colorFrame.AnchorPoint = Vector2.new(0.5, 0)
    colorFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    colorFrame.BorderSizePixel = 0
    colorFrame.Position = UDim2.fromScale(0.5, 0)
    colorFrame.Size = UDim2.fromScale(1, 0.92)
    colorFrame.ZIndex = 1
    colorFrame.Parent = base
    addRedGradient(colorFrame, "RedGradient", rebirthOuterGradient)

    local highlight = Instance.new("Frame")
    highlight.Name = "Transparent"
    highlight.Active = false
    highlight.AnchorPoint = Vector2.new(0.5, 0.5)
    highlight.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    highlight.BorderSizePixel = 0
    highlight.Position = UDim2.fromScale(0.5, 0.5)
    highlight.Size = UDim2.fromScale(0.965, 0.88)
    highlight.ZIndex = 2
    highlight.Parent = colorFrame
    addRedGradient(highlight, "RedGradient", rebirthInnerGradient)

    -- Framewisp Button Texture (Asset 109248302930363)
    local btnPattern = Instance.new("ImageLabel")
    btnPattern.Name = "ButtonPattern"
    btnPattern.BackgroundTransparency = 1
    btnPattern.BorderSizePixel = 0
    btnPattern.AnchorPoint = Vector2.new(0.5, 0.5)
    btnPattern.Position = UDim2.fromScale(0.5, 0.5)
    btnPattern.Size = UDim2.fromScale(1, 1)
    btnPattern.Image = "rbxassetid://109248302930363"
    btnPattern.ImageColor3 = Color3.fromRGB(180, 230, 255)
    btnPattern.ImageTransparency = 0.35
    btnPattern.ScaleType = Enum.ScaleType.Stretch
    btnPattern.ZIndex = 3
    btnPattern.Parent = highlight

    local caption = Instance.new("TextLabel")
    caption.Name = "Label"
    caption.Active = false
    caption.AnchorPoint = Vector2.new(0.5, 0.5)
    caption.BackgroundTransparency = 1
    caption.BorderSizePixel = 0
    caption.Position = UDim2.fromScale(0.5, 0.5)
    caption.Size = UDim2.fromScale(0.9, 0.72)
    caption.Text = currentButtonText
    caption.TextWrapped = true
    caption.ZIndex = 6
    caption.Parent = colorFrame
    applyShinyTextStyle(caption, normalTextFont)

    -- Smooth tactile hover and depression feedback
    button.MouseEnter:Connect(function()
        if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(button) then return end
        TweenService:Create(base, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = Color3.fromRGB(0, 115, 245) }):Play()
        TweenService:Create(baseStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Color = Color3.fromRGB(80, 245, 255), Thickness = 1.3 }):Play()
    end)
    button.MouseLeave:Connect(function()
        if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(button) then return end
        if btnScale and btnScale.Parent then
            TweenService:Create(btnScale, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.0 }):Play()
        end
        TweenService:Create(base, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = Color3.fromRGB(0, 70, 180) }):Play()
        TweenService:Create(baseStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Color = Color3.fromRGB(0, 220, 255), Thickness = 1.2 }):Play()
    end)
    button.MouseButton1Down:Connect(function()
        if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(button) then return end
        if btnScale and btnScale.Parent then
            TweenService:Create(btnScale, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 0.93 }):Play()
        end
    end)
    button.MouseButton1Up:Connect(function()
        if btnScale and btnScale.Parent then
            TweenService:Create(btnScale, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.0 }):Play()
        end
    end)

    local pressCooldown = false
    local function playPress()
        if pressCooldown then return end
        pressCooldown = true
        task.delay(0.18, function() pressCooldown = false end)

        -- Crisp tactile mechanical click sound
        pcall(function()
            local sound = Instance.new("Sound")
            sound.Name = "ButtonTactileClick"
            sound.SoundId = "rbxassetid://102702078778790"
            sound.Volume = 0.35
            sound.Parent = SoundService or rootGui
            sound:Play()
            Debris:AddItem(sound, 1.5)
        end)

        -- Smooth tactile micro-depression & elastic rebound snapback
        if btnScale and btnScale.Parent then
            TweenService:Create(btnScale, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 0.92 }):Play()
            task.delay(0.055, function()
                if btnScale.Parent then
                    TweenService:Create(btnScale, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.0 }):Play()
                end
            end)
        end

        -- Flash inner highlight transparency
        if colorFrame and colorFrame.Parent then
            TweenService:Create(colorFrame, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.28 }):Play()
            task.delay(0.07, function()
                if colorFrame.Parent then
                    TweenService:Create(colorFrame, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0 }):Play()
                end
            end)
        end

        -- Electric cyan border flash
        if baseStroke and baseStroke.Parent then
            TweenService:Create(baseStroke, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Color = Color3.fromRGB(180, 255, 255),
                Thickness = 1.6
            }):Play()
            task.delay(0.08, function()
                if baseStroke.Parent then
                    TweenService:Create(baseStroke, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Color = Color3.fromRGB(0, 220, 255),
                        Thickness = 1.2
                    }):Play()
                end
            end)
        end

        -- Optional temporary text feedback (only if ClickedText / ConfirmText is configured)
        if currentConfirmText and not busy then
            busy = true
            caption.Text = currentConfirmText
            task.delay(0.70, function()
                if caption and caption.Parent then
                    caption.Text = currentButtonText
                end
                busy = false
            end)
        end
    end

    local function setActionText(text)
        currentButtonText = tostring(text or "Click")
        if not busy and caption and caption.Parent then
            caption.Text = currentButtonText
        end
    end

    return row, playPress, setActionText
end

