            activeFill.BackgroundTransparency = targetFillTrans
            switchStroke.Color = targetStrokeColor
            switchStroke.Transparency = targetStrokeTrans
            thumb.BackgroundColor3 = targetThumbColor
            thumbStroke.Color = targetThumbStroke
        else
            local animInfo = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(thumb, animInfo, { Position = targetPos }):Play()
            TweenService:Create(activeFill, animInfo, { BackgroundTransparency = targetFillTrans }):Play()
            TweenService:Create(switchStroke, animInfo, {
                Color = targetStrokeColor,
                Transparency = targetStrokeTrans,
            }):Play()
            TweenService:Create(thumb, animInfo, {
                BackgroundColor3 = targetThumbColor,
            }):Play()
            TweenService:Create(thumbStroke, animInfo, {
                Color = targetThumbStroke,
            }):Play()
        end

        if fireCallback ~= false then
            safeCallback(config.Callback, enabled)
        end
