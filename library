local function setResizeGlowState(state)
    if activeGlowFadeTween then
        activeGlowFadeTween:Cancel()
        activeGlowFadeTween = nil
    end

    if state == "dragging" then
        if objects.obj3 then
            TweenService:Create(objects.obj3, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Color = Color3.fromRGB(40, 235, 255),
                Thickness = 2.4,
