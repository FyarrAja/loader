    local sharedClickSound = Instance.new("Sound")
    sharedClickSound.Name = "FW_SharedClickSound"
    sharedClickSound.SoundId = "rbxassetid://102702078778790"
    sharedClickSound.Volume = 0.35
    sharedClickSound.Parent = SoundService or gui

    local function wire(btn)
        if wired[btn] then return end
        wired[btn] = true

        local sndClick = buttonSound(btn, { "ClickSound", "FigmaClickSound", "SmoothClickSound" }, nil) or sharedClickSound
        if sndClick then
            local lastClickSoundAt = 0
            btn.Activated:Connect(function()
                if Runtime.isSystemLoadingActive then return end
                if mainFrame and btn:IsDescendantOf(mainFrame) and not mainFrame.Visible then return end
                if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(btn) then return end
                local now = os.clock()
                if now - lastClickSoundAt < 0.15 then return end
                lastClickSoundAt = now
                if sndClick == sharedClickSound then
                    pcall(function() sharedClickSound:Play() end)
                else
                    voice(sndClick)
                end
            end)
        end

        if btn:GetAttribute("FigmaMagnet") and UserInputService.MouseEnabled then
            magnets[#magnets + 1] = {
                btn = btn,
                pull = btn:GetAttribute("MagnetPull") or btn:GetAttribute("FigmaMagnetPull") or MAGNET_PULL,
                radius = btn:GetAttribute("MagnetRadius") or btn:GetAttribute("FigmaMagnetRadius") or MAGNET_RADIUS,
                ox = 0, oy = 0, vx = 0, vy = 0,
            }
            startMagnetLoop()
        end

        -- Smooth Spring Scaling (Skipped for list/grid children so sibling buttons never shift or misalign)
        btn.AutoButtonColor = false
        if not laidOutBy(btn) then
            centreAnchor(btn)
            local scale = fwChannel(btn, "k_btn")
            local base = scale.Value
            local hoverK = btn:GetAttribute("SmoothHover") or btn:GetAttribute("FigmaSmoothHover") or 1.035
            local pressK = btn:GetAttribute("SmoothPress") or btn:GetAttribute("FigmaSmoothPress") or 0.94
            local hovering, held, tween = false, false, nil

            local function glide(target, t, style, dir)
                if tween then tween:Cancel() end
                tween = TweenService:Create(
                    scale,
                    TweenInfo.new(t or 0.12, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
                    { Value = target }
                )
                tween:Play()
            end

            local function release()
                if not held then return end
                held = false
                glide(hovering and base * hoverK or base, 0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            end

            btn.MouseEnter:Connect(function()
                hovering = true
                if not held then glide(base * hoverK, 0.14) end
            end)
            btn.MouseLeave:Connect(function()
                hovering = false
                if held then
                    release()
                else
                    glide(base, 0.14)
                end
            end)
            btn.MouseButton1Down:Connect(function()
                held = true
                glide(base * pressK, 0.075)
            end)
            btn.MouseButton1Up:Connect(release)
        end

        -- States handling (only scan children unless FigmaHasStates is set)
        local states = {}
        local stateCandidates = btn:GetAttribute("FigmaHasStates") and btn:GetDescendants() or btn:GetChildren()
        for _, c in ipairs(stateCandidates) do
            local s = c:GetAttribute("FigmaState")
            if (s == "hover" or s == "clicked" or s == "disabled" or s == "default") and not states[s] then
                local owned, n = true, c.Parent
                while n and n ~= btn do
                    if n:IsA("GuiButton") then owned = false break end
                    n = n.Parent
                end
                if owned then states[s] = c end
            end
        end
        if next(states) then
            local function show(name)
                for s, c in pairs(states) do
                    if s == "default" then
                        c.Visible = (name == nil)
                    else
                        c.Visible = (s == name)
                    end
                end
            end
            local function disabled()
                local ok, value = pcall(function() return btn.Interactable == false end)
                return (ok and value) or btn.Active == false
            end
            local function rest() show(disabled() and states.disabled and "disabled" or nil) end
            btn.MouseEnter:Connect(function()
                if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(btn) then return end
                if not disabled() and states.hover then show("hover") end
            end)
            btn.MouseLeave:Connect(function()
                if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(btn) then return end
                rest()
            end)
            btn.MouseButton1Down:Connect(function()
                if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(btn) then return end
                if not disabled() and states.clicked then show("clicked") end
            end)
            btn.MouseButton1Up:Connect(function()
                if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(btn) then return end
                if disabled() then rest() else show(states.hover and "hover" or nil) end
            end)
            btn:GetPropertyChangedSignal("Active"):Connect(rest)
            pcall(function() btn:GetPropertyChangedSignal("Interactable"):Connect(rest) end)
            rest()
        end

        -- Dim feedback for buttons with Dim attribute enabled
        if btn:GetAttribute("FigmaDim") or btn:GetAttribute("HoverDim") then
            local targets = dimTargets(btn)
            if #targets > 0 then
                local hoverDim = btn:GetAttribute("HoverDim") or btn:GetAttribute("FigmaHoverDim") or HOVER
                local pressDim = btn:GetAttribute("PressDim") or btn:GetAttribute("FigmaPressDim") or PRESS
                local function toDim(k)
                    for _, tg in ipairs(targets) do
                        local c = tg.base
                        tg.own = tg.own + 1
                        local tw = TweenService:Create(tg.inst, TweenInfo.new(TIME), { [tg.prop] = Color3.new(c.R * k, c.G * k, c.B * k) })
                        tw.Completed:Once(function()
                            if tg.own > 0 then tg.own = tg.own - 1 end
                        end)
                        tw:Play()
                    end
                end
                btn.MouseEnter:Connect(function()
                    if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(btn) then return end
                    toDim(hoverDim)
                end)
                btn.MouseLeave:Connect(function()
                    if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(btn) then return end
                    toDim(1)
                end)
                btn.MouseButton1Down:Connect(function()
                    if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(btn) then return end
                    toDim(pressDim)
                end)
                btn.MouseButton1Up:Connect(function()
                    if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(btn) then return end
                    toDim(hoverDim)
                end)
            end
        end
    end

    local function wireSquish(btn)
        if not btn:GetAttribute("FigmaSquish") and not btn:GetAttribute("FW_Squish") then return end
        if btn:GetAttribute("FW_SquishWired") then return end
        btn:SetAttribute("FW_SquishWired", true)
        slotFor(btn)
        centreAnchor(btn)
        local base = nil
        local tw = nil
        local function squash(on)
            if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(btn) then return end
            if base == nil then base = btn.Size end
            local amp = (btn:GetAttribute("SquishAmp") or btn:GetAttribute("FigmaSquishAmp") or 7) / 100
            local t = btn:GetAttribute("SquishTime") or btn:GetAttribute("FigmaSquishTime") or 0.16
            if tw then tw:Cancel() end
            local target = on
                and UDim2.new(base.X.Scale * (1 + amp), base.X.Offset * (1 + amp), base.Y.Scale * (1 - amp), base.Y.Offset * (1 - amp))
                or base
            tw = TweenService:Create(btn, TweenInfo.new(on and t / 2.5 or t, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = target })
            tw:Play()
        end
        btn.MouseButton1Down:Connect(function() squash(true) end)
        btn.MouseButton1Up:Connect(function() squash(false) end)
        btn.MouseLeave:Connect(function() if base and btn.Size ~= base then squash(false) end end)
    end

    local function wireRipple(btn)
        if not btn:GetAttribute("FigmaRipple") and not btn:GetAttribute("FW_Ripple") then return end
        if btn:GetAttribute("FW_RippleWired") then return end
        btn:SetAttribute("FW_RippleWired", true)
        btn.InputBegan:Connect(function(input)
            if Runtime.isElementBlockedByModal and Runtime.isElementBlockedByModal(btn) then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local host = Instance.new("Frame")
            host.Name = "FW_RippleHost"
            host.BackgroundTransparency = 1
            host.Size = UDim2.fromScale(1, 1)
            host.ClipsDescendants = true
            host:SetAttribute("FW_Owned", true)
            local corner = btn:FindFirstChildWhichIsA("UICorner")
            if corner then corner:Clone().Parent = host end
            local top = btn.ZIndex
            for _, d in ipairs(btn:GetChildren()) do
                if d:IsA("GuiObject") and d.ZIndex > top then top = d.ZIndex end
            end
            host.ZIndex = top + 2
            host.Parent = btn

            local c = btn:GetAttribute("RippleColor") or btn:GetAttribute("FigmaRippleColor")
            local color3 = (typeof(c) == "Color3" and c)
                or (type(c) == "number" and Color3.fromRGB(math.floor(c / 65536) % 256, math.floor(c / 256) % 256, c % 256))
                or Color3.fromRGB(0, 225, 255)
            local op = btn:GetAttribute("RippleOp") or btn:GetAttribute("FigmaRippleOp") or 0.42
            local t = btn:GetAttribute("RippleTime") or btn:GetAttribute("FigmaRippleTime") or 0.42

            local dot = Instance.new("Frame")
            dot.AnchorPoint = Vector2.new(0.5, 0.5)
            dot.BorderSizePixel = 0
            dot.BackgroundColor3 = color3
            dot.BackgroundTransparency = 1 - op
            dot.Position = UDim2.fromOffset(input.Position.X - btn.AbsolutePosition.X, input.Position.Y - btn.AbsolutePosition.Y)
            dot.Size = UDim2.fromOffset(0, 0)
            local round = Instance.new("UICorner")
            round.CornerRadius = UDim.new(1, 0)
            round.Parent = dot
            dot.ZIndex = host.ZIndex
            dot.Parent = host

            local sz = btn.AbsoluteSize
            local px = input.Position.X - btn.AbsolutePosition.X
            local py = input.Position.Y - btn.AbsolutePosition.Y
            local far = math.sqrt(math.max(px, sz.X - px) ^ 2 + math.max(py, sz.Y - py) ^ 2)
            local m = far * 2.2

            TweenService:Create(dot, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Size = UDim2.fromOffset(m, m) }):Play()
            TweenService:Create(dot, TweenInfo.new(t * 0.88, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { BackgroundTransparency = 1 }):Play()
            task.delay(t + 0.08, function() host:Destroy() end)
        end)
    end

