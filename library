            track.BackgroundColor3 = Color3.fromRGB(10, 52, 110)
            track.Position = UDim2.new(0, 0, 0, 48)
            track.Size = UDim2.new(1, 0, 0, 8)
            track.ZIndex = 507
            track.Parent = contentArea

            local trStroke = Instance.new("UIStroke")
            trStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            trStroke.Color = Color3.fromRGB(0, 220, 255)
            trStroke.Thickness = 1.0
            trStroke.Transparency = 0.20
            trStroke.Parent = track

            progressBar = Instance.new("Frame")
            progressBar.Name = "ProgressBar"
            progressBar.Active = false
            progressBar.BorderSizePixel = 0
            progressBar.BackgroundColor3 = Color3.fromRGB(0, 235, 255)
            progressBar.Position = UDim2.new(0, 0, 0, 0)
            progressBar.Size = UDim2.new(0, 0, 1, 0)
            progressBar.ZIndex = 508
            progressBar.Parent = track

            local barGrad = Instance.new("UIGradient")
            barGrad.Name = "BarGrad"
            barGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.60, Color3.fromRGB(0, 210, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 140, 255))
            })
            barGrad.Parent = progressBar
        end

        -- Phase 2: Once blur is gently established, progress popup floats & pops in
        task.delay(1.0, function()
            capsule.Visible = true
            TweenService:Create(capsuleScale, TweenInfo.new(0.50, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Scale = 1
            }):Play()
            TweenService:Create(capsule, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, 0, 0.5, 0)
            }):Play()
        end)

        -- Dynamic & Smart Loading Scanner: Inspects actual script content & environment
        task.spawn(function()
            local function detectPlatformName()
                local okPlat, plat = pcall(function()
                    return UserInputService:GetPlatform()
                end)
                if okPlat and plat then
                    if plat == Enum.Platform.Windows then
                        return "PC (Windows)"
                    end
                    if plat == Enum.Platform.OSX then
                        return "Mac (macOS)"
                    end
                    if plat == Enum.Platform.Android then
                        return "Mobile (Android)"
                    end
                    if plat == Enum.Platform.IOS then
                        return "Mobile (iOS)"
                    end
                    if plat == Enum.Platform.UWP then
                        return "PC (Windows Store)"
                    end
                    if plat == Enum.Platform.XBoxOne or plat == Enum.Platform.PS4 or plat == Enum.Platform.PS5 then
                        return "Console"
                    end
                end

                local okOs, osName = pcall(function()
                    local getOsFn = getos or get_os
                    if getOsFn then
                        return getOsFn()
                    end
                end)
                if okOs and type(osName) == "string" and osName ~= "" then
                    return tostring(osName)
                end

                if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
                    return "Mobile Device"
                end
                if UserInputService.KeyboardEnabled and UserInputService.MouseEnabled then
                    return "PC (Desktop)"
                end
                return "Roblox Client"
            end

            local function readScriptTelemetry()
                local pName = "Player"
                pcall(function()
                    local lp = game:GetService("Players").LocalPlayer
                    if lp and lp.Name then pName = lp.Name end
                end)

                local placeName = "Roblox Place"
                pcall(function()
                    local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
                    if info and info.Name and #info.Name > 0 then
                        placeName = info.Name
                    end
                end)

                local tabs = (window and window.Tabs) or {}
                local tabCount = #tabs
                local tabNames = {}
                local sectionCount = 0

                for _, t in ipairs(tabs) do
                    local tName = t.DisplayName or t.Name or "Tab"
                    table.insert(tabNames, tName)
                    if t._sectionByName then
                        for _ in pairs(t._sectionByName) do
                            sectionCount = sectionCount + 1
                        end
                    end
                end

                local platformName = detectPlatformName()

                return pName, placeName, tabCount, tabNames, sectionCount, platformName
            end

            -- Allow blur and capsule entrance animation to settle before scanning
            task.wait(1.15)

            local pName, placeName, tabCount, tabNames, sectionCount, platformName = readScriptTelemetry()

            if deviceTagLabel then
                deviceTagLabel.Text = "[" .. platformName .. "]"
            end

            -- Build Dynamic Stages tailored to this exact script & game
            local shortGame = placeName
            if #shortGame > 24 then
                shortGame = shortGame:sub(1, 22) .. ".."
            end

            local tabPreview = ""
            if tabCount > 0 then
                local p = {}
                for i = 1, math.min(3, #tabNames) do
                    table.insert(p, tabNames[i])
                end
                tabPreview = table.concat(p, ", ") .. (#tabNames > 3 and "..." or "")
            end

            local stages = {
                {
                    pct = 16,
                    dur = 0.75,
                    text = "Mendeteksi Platform: " .. platformName
                },
                {
                    pct = 36,
                    dur = 0.80,
                    text = "Game: " .. shortGame .. " (" .. tostring(game.PlaceId) .. ")"
                },
                {
                    pct = 60,
                    dur = 0.85,
                    text = (tabCount > 0)
                        and ("Memuat " .. tostring(tabCount) .. " Tab (" .. tabPreview .. ")...")
                        or "Memuat modul antarmuka BlueHaven..."
                },
                {
                    pct = 80,
                    dur = 0.80,
                    text = (sectionCount > 0)
                        and ("Mengompilasi " .. tostring(sectionCount) .. " Section & Komponen...")
                        or "Menyiapkan komponen & fungsi skrip..."
                },
                {
                    pct = 94,
                    dur = 0.75,
                    text = "Optimalisasi Tata Letak (" .. platformName .. ")..."
                },
                {
                    pct = 100,
                    dur = 0.65,
                    text = "Siap Digunakan di " .. platformName .. "! (" .. pName .. ")"
                },
            }

            for _, st in ipairs(stages) do
                stepLabel.Text = st.text
                percentLabel.Text = tostring(st.pct) .. "%"
                local tween = TweenService:Create(progressBar, TweenInfo.new(st.dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(st.pct / 100, 0, 1, 0)
                })
                tween:Play()
                task.wait(st.dur)
            end

            task.wait(0.35)

            -- Phase 4: Popup floats out while Blur smoothly fades out to 0
            if bobTween then
                pcall(function() bobTween:Cancel() end)
            end

            local blurOutTween = nil
            if loadingBlur and loadingBlur.Parent then
                blurOutTween = TweenService:Create(loadingBlur, TweenInfo.new(0.60, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    Size = 0
                })
                blurOutTween:Play()
            end

            local exitTween = TweenService:Create(capsuleScale, TweenInfo.new(0.40, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
                Scale = 0.78
            })
            exitTween:Play()
            TweenService:Create(capsule, TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
                Position = UDim2.new(0.5, 0, 0.47, 0)
            }):Play()

            -- Phase 5: Once blur disappears smoothly, wait 1 second on clean screen, then open Main GUI!
            local function finishAndOpen()
                pcall(function()
                    if loadingBlur and loadingBlur.Parent then
                        loadingBlur:Destroy()
                    end
                end)
                pcall(function() barrier:Destroy() end)
                Runtime.isSystemLoadingActive = false

                task.wait(1.0)

                -- Reveal Main GUI with signature smooth open animation
                Runtime.chilliIsOpen = false
                mainFrame.Visible = true
                playOpenAnimation()

                -- Reveal Mobile Mascot Floating Toggle
                if Runtime.shouldShowMobileToggle and Runtime.shouldShowMobileToggle() then
                    local ft = Runtime.floatingToggle or (rootGui and rootGui:FindFirstChild("BlueHavenFloatingToggle"))
                    if ft then ft.Visible = true end
                end

                -- Trigger Clean Notification: "Siap digunakan!"
                if _G.BH_ShowNotification ~= false then
                    pcall(function()
                        local icon = (_G.BH_ResolveCatAsset and _G.BH_ResolveCatAsset()) or ""
                        local notifData = {
                            Title = "BlueHaven Hub (" .. platformName .. ")",
                            Text = "Siap digunakan!",
                            Duration = 3,
                        }
                        if type(icon) == "string" and #icon > 0 and icon:find("rbxasset") then
                            notifData.Icon = icon
                        end
                        game:GetService("StarterGui"):SetCore("SendNotification", notifData)
                    end)
                end
            end

            if blurOutTween then
                blurOutTween.Completed:Connect(finishAndOpen)
            else
                exitTween.Completed:Connect(finishAndOpen)
            end
        end)
    end)
end

