        local function paint(animated)
            local chosen = isChosen()
            local bgAlpha = chosen and 0.30 or (hovered and 0.72 or 1)
            local bgColor = chosen and Color3.fromRGB(0, 135, 245) or (hovered and Color3.fromRGB(0, 160, 255) or Color3.fromRGB(255, 255, 255))
            local strokeAlpha = chosen and 0.20 or (hovered and 0.55 or 1)
            local strokeColor = chosen and Color3.fromRGB(80, 235, 255) or Color3.fromRGB(0, 200, 255)

            if multiSelect then
                tickBox.BackgroundColor3 = chosen and Color3.fromRGB(0, 175, 255) or Color3.fromRGB(15, 48, 92)
                tickBox.BackgroundTransparency = chosen and 0 or 0.4
                if tbStroke then
                    tbStroke.Color = chosen and Color3.fromRGB(0, 245, 255) or Color3.fromRGB(0, 200, 255)
                    tbStroke.Transparency = chosen and 0 or 0.35
                end
                tickCheck.Visible = chosen
            else
                accentBar.Visible = chosen
                accentBar.Size = UDim2.new(0, chosen and 3 or 0, 1, 0)
                singleCheck.Visible = chosen
            end

            text.TextColor3 = chosen and Color3.fromRGB(255, 255, 255) or (hovered and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(225, 242, 255))

            if animated then
                local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
